# Copy this file to .env (same folder) and fill in the values for your
# machine. .env is gitignored — real keys never get committed.

# --- Database (XAMPP defaults shown) ---
DB_HOST=127.0.0.1
DB_NAME=lost_and_found
DB_USER=root
DB_PASS=

# --- ImgBB (Section 7.2) — optional. Leave blank to use icon fallback. ---
# Get a free key at https://api.imgbb.com/
IMGBB_API_KEY=
IMGBB_EXPIRATION_SECONDS=7776000

# --- Live updates (realtime/server.php, Workerman) ---
# Browsers connect to REALTIME_WS_HOST:REALTIME_WS_PORT for live updates.
# The PHP API publishes to that same port, authenticated with the secret
# below so random connections on the port can't spoof events. Change the
# secret to anything — it just has to match between the two.
REALTIME_WS_HOST=0.0.0.0
REALTIME_WS_PORT=8081
REALTIME_PUBLISH_SECRET=lf-local-dev-secret
